{
  "expo": {
    "name": "Passport",
    "slug": "mobile",
    "scheme": "passportapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070a",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.passport.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Passport uses the camera to scan a passport's QR code for verification.",
        "NSFaceIDUsageDescription": "Passport can use Face ID to protect this device's signing key."
      }
    },
    "android": {
      "package": "com.passport.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#05070a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Passport uses the camera to scan a passport's QR code for verification."
        }
      ]
    ]
  }
}
